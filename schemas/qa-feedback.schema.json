{
  "title": "qa-feedback output: what this QA run did, for the human",
  "type": "object",
  "required": ["suiteChanges", "acCoverage", "results", "defects", "findings", "recommendedVerdict", "qaPrMarkdown", "jiraMarkdown"],
  "additionalProperties": false,
  "properties": {
    "suiteChanges": {
      "type": "object", "required": ["updated", "added", "deleted"],
      "properties": {
        "updated": { "type": "array", "items": { "type": "object", "required": ["file", "why"], "properties": { "file": { "type": "string" }, "source": { "enum": ["ticket", "code", "triage"] }, "acId": { "type": "string" }, "why": { "type": "string" } } } },
        "added": { "type": "array", "items": { "type": "object", "required": ["file", "why"], "properties": { "file": { "type": "string" }, "source": { "enum": ["ticket", "code", "triage"] }, "acId": { "type": "string" }, "why": { "type": "string" } } } },
        "deleted": { "type": "array", "items": { "type": "object", "required": ["file", "why"], "properties": { "file": { "type": "string" }, "source": { "enum": ["ticket", "code", "triage"] }, "acId": { "type": "string" }, "why": { "type": "string" } } } }
      }
    },
    "acCoverage": {
      "type": "array",
      "items": {
        "type": "object", "required": ["acId", "before", "after"],
        "properties": { "acId": { "type": "string" }, "before": { "type": "string" }, "after": { "type": "string" }, "result": { "enum": ["pass", "fail", "manual", "not-run"] } }
      }
    },
    "results": {
      "type": "object", "required": ["passed", "failed", "total"],
      "properties": { "passed": { "type": "integer" }, "failed": { "type": "integer" }, "skipped": { "type": "integer" }, "total": { "type": "integer" }, "flaky": { "type": "integer" } }
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object", "required": ["test", "evidence"],
        "properties": { "acId": { "type": "string" }, "test": { "type": "string" }, "evidence": { "type": "string" }, "trace": { "type": "string" } }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object", "required": ["type", "detail"],
        "properties": {
          "type": { "enum": ["req-not-implemented", "req-untested", "regression-risk", "coverage-limitation", "pre-existing-failure", "code-observation"] },
          "acId": { "type": "string" }, "detail": { "type": "string" }
        }
      }
    },
    "recommendedVerdict": { "enum": ["QA Passed", "QA Failed", "needs-human-judgment"] },
    "qaPrMarkdown": { "type": "string", "minLength": 1 },
    "jiraMarkdown": { "type": "string", "minLength": 1 }
  }
}
